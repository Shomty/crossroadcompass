# Crossroads Compass — Local Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# ─── Swiss Ephemeris data files (HD + Vedic — openhumandesign-library + openastrology-library) ─
# Download required .se1 files from https://www.astro.com/ftp/swisseph/ephe/
# and place them in ./ephe/  (see npm run download-ephe)
# Vedic charts are computed locally — there is no Vedic REST API or VEDIC_API_* env vars.
EPHE_PATH=./ephe

# ─── Database ──────────────────────────────────────────────────────────────
# Local dev uses SQLite. For production, switch to postgresql://...
DATABASE_URL=file:./prisma/dev.db
# Before prisma migrate: ./scripts/backup-sqlite.sh

# ─── Stripe ────────────────────────────────────────────────────────────────
# Optional until task #11 (real Stripe). Mock payment service is active while empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email via Resend ──────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Auth (NextAuth v5) ────────────────────────────────────────────────────
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Supabase (PDF report storage) ────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# ─── Upstash Redis (KV cache for chart data) ───────────────────────────────
# Free tier: https://console.upstash.com — create a Redis database
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─── Gemini AI ─────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# @google/generative-ai (report marketplace, admin Gemini test). Use IDs from Google AI Studio / ListModels.
# Default below: Gemini 3.1 Flash-Lite Preview (text generateContent). For Gemini 3 Flash (non-Lite): gemini-3-flash-preview
GEMINI_MODEL=gemini-3.1-flash-lite-preview
# Chat feature model selection (free tier uses Flash, premium uses Pro)
GEMINI_MODEL_PRO=gemini-2.5-flash
GEMINI_MODEL_FLASH=gemini-2.5-flash
ADMIN_EMAIL=shomty@hotmail.com

# ─── Bank transfer (admin panel — send instructions email) ────────────────
BANK_ACCOUNT_NAME=
BANK_IBAN=
BANK_BIC=
BANK_REFERENCE_PREFIX=CC

# ─── App URL ──────────────────────────────────────────────────────────────
# Used by cron routes to build absolute URLs. Defaults to NEXTAUTH_URL if unset.
APP_URL=http://localhost:3000

# ─── Cron authentication (set in Vercel; leave blank locally) ─────────────
CRON_SECRET=
