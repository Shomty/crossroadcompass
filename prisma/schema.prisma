  rahuHouse                Int?
  rahuSign                 String?
  rajaYogasCount           Int?
  retrogradeCount          Int?
  saturnHouse              Int?
  saturnRetrograde         Boolean?
  saturnSign               String?
  specialPointsCalcAt      DateTime?
  strongYogasCount         Int?
  strongestHouseNum        Int?
  sunCombust               Boolean?
  sunDignity               String?
  sunHouse                 Int?
  sunNakshatra             String?
  sunRetrograde            Boolean?
  sunSign                  String?
  topYogaName              String?
  topYogaStrength          Float?
  totalInsightsCount       Int?
  totalYogasCount          Int?
  transitCacheDate         DateTime?
  transitJupiterSign       String?
  transitMarsSign          String?
  transitMoonNakshatra     String?
  transitMoonSign          String?
  transitSaturnRetro       Boolean?
  transitSaturnSign        String?
  transitSunSign           String?
  venusHouse               Int?
  venusSign                String?
  weakestHouseNum          Int?
  yogaNamesAll             String?
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_astro_snapshots")
}

model Transit {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  data      Json
  fetchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("transits")
}

model Dasha {
  id         String     @id @default(cuid())
  userId     String
  startDate  DateTime
  endDate    DateTime
  planetName String
  level      DashaLevel
  fetchedAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startDate, endDate])
  @@map("dashas")
}

model Insight {
  id                   String      @id @default(cuid())
  userId               String
  type                 InsightType
  periodDate           DateTime
  content              String
  generatedAt          DateTime    @default(now())
  reviewedByConsultant Boolean     @default(false)
  reviewedAt           DateTime?
  deliveredAt          DateTime?
  rejectedAt           DateTime?
  rejectedBy           String?
  accuracyRating       Int?
  insightFeedback      String?
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, periodDate])
  @@index([userId, type, periodDate])
  @@map("insights")
}

model ConsultationBooking {
  id                 String           @id @default(cuid())
  userId             String
  tier               ConsultationTier
  status             BookingStatus    @default(PENDING)
  scheduledAt        DateTime?
  calendlyEventId    String?
  stripePaymentId    String?
  amountCents        Int
  consultantNotes    String?
  prepGuideEmailSent Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("consultation_bookings")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model PromptTemplate {
  id                 String                  @id @default(cuid())
  promptKey          String                  @unique
  feature            PromptFeature
  hdType             String?
  systemPrompt       String
  userPromptTemplate String
  bannedPhrases      String                  @default("")
  maxTokens          Int                     @default(800)
  temperature        Float                   @default(0.8)
  version            Int                     @default(1)
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  updatedBy          String
  history            PromptTemplateVersion[]

  @@map("prompt_templates")
}

model PromptTemplateVersion {
  id                 String         @id @default(cuid())
  promptTemplateId   String
  systemPrompt       String
  userPromptTemplate String
  version            Int
  savedAt            DateTime       @default(now())
  savedBy            String
  promptTemplate     PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)

  @@index([promptTemplateId])
  @@map("prompt_template_versions")
}

model AuditLog {
  id          String          @id @default(cuid())
  timestamp   DateTime        @default(now())
  adminEmail  String
  actionType  AuditActionType
  targetId    String?
  targetType  String?
  before      String?
  after       String?
  notes       String?
  /// Free-form action label (e.g. task-spec action strings) for admin panel filtering
  actionLabel String?
  detail      String?
  ip          String?

  @@index([adminEmail])
  @@index([actionType])
  @@index([timestamp])
  @@map("audit_logs")
}

model FeatureFlag {
  key       String   @id
  value     Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String

  @@map("feature_flags")
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String

  @@map("system_configs")
}

model CronRun {
  id                String    @id @default(cuid())
  jobName           String
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  usersProcessed    Int       @default(0)
  insightsGenerated Int       @default(0)
  errorCount        Int       @default(0)
  errors            String?

  @@index([jobName])
  @@index([startedAt])
  @@map("cron_runs")
}

model ReportProduct {
  id                 String                @id @default(cuid())
  slug               String                @unique
  title              String
  subtitle           String?
  description        String
  category           ReportCategory
  priceUsd           Int
  isActive           Boolean               @default(true)
  sortOrder          Int                   @default(0)
  coverImageUrl      String?
  geminiPrompt       String
  /// Incremented when a new ReportPromptVersion row is saved.
  promptVersion      Int                   @default(1)
  estimatedWordCount Int                   @default(2000)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  createdBy          String
  /// Set when admin soft-deletes; slug is rewritten with `--del--{id}` to keep slug unique.
  deletedAt          DateTime?
  purchases          ReportPurchase[]
  promptVersions     ReportPromptVersion[]

  @@index([deletedAt])
}

/// Version history for ReportProduct.geminiPrompt (admin prompt editor).
model ReportPromptVersion {
  id              String        @id @default(cuid())
  reportProductId String
  version         Int
  prompt          String
  savedBy         String
  savedAt         DateTime      @default(now())
  testResult      String?
  reportProduct   ReportProduct @relation(fields: [reportProductId], references: [id], onDelete: Cascade)

  @@index([reportProductId])
  @@map("report_prompt_versions")
}

model ReportPurchase {
  id              String               @id @default(cuid())
  userId          String
  reportProductId String
  stripePaymentId String?              @unique
  amountPaidUsd   Int
  status          ReportPurchaseStatus @default(PENDING)
  purchasedAt     DateTime             @default(now())
  generatedReport GeneratedReport?
  reportProduct   ReportProduct        @relation(fields: [reportProductId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reportProductId])
}

model GeneratedReport {
  id               String                 @id @default(cuid())
  purchaseId       String                 @unique
  status           ReportGenerationStatus @default(DONE)
  errorMsg         String?
  regeneratedAt    DateTime?
  content          String                 @default("")
  wordCount        Int                    @default(0)
  generatedAt      DateTime               @default(now())
  geminiModel      String                 @default("")
  generationTimeMs Int?
  purchase         ReportPurchase         @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

/// Periodic AI synthesis reports (daily / weekly / monthly).
/// Keyed by userId + period + periodKey (e.g. "2026-04-01", "2026-W14", "2026-04").
/// expiresAt controls server-side invalidation; KV is still used as hot cache.
model PeriodicReport {
  id          String   @id @default(cuid())
  userId      String
  period      String   // "daily" | "weekly" | "monthly"
  periodKey   String   // e.g. "2026-04-01", "2026-W14", "2026-04"
  text        String
  generatedAt DateTime @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, periodKey])
  @@index([userId, period])
  @@map("periodic_reports")
}

enum UserRole {
  USER
  ADMIN
}

enum DashaLevel {
  MAHADASHA
  ANTARDASHA
}

enum InsightType {
  DAILY
  WEEKLY
  MONTHLY
  INITIAL
  DASHA
  CAREER
  LOVE
  HEALTH
  JYOTISH
  MUHURTA_WEEKLY
  SPECIAL_POINTS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ConsultationTier {
  SINGLE_90
  VIP_QUARTERLY
}

enum SubscriptionTier {
  FREE
  CORE
  VIP
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum PromptFeature {
  DAILY_INSIGHT
  WEEKLY_FORECAST
  MONTHLY_REPORT
  HD_TIP
  ONBOARDING_REPORT
  WELCOME_EMAIL
  PRESESSION_EMAIL
  TRANSIT_ALERT_EMAIL
  LIFE_READING
  TRANSIT_READING
}

enum AuditActionType {
  INSIGHT_APPROVED
  INSIGHT_REJECTED
  INSIGHT_EDITED
  PROMPT_SAVED
  PROMPT_ROLLED_BACK
  USER_TIER_CHANGED
  USER_CHART_INVALIDATED
  USER_DELETED
  CONSULTATION_STATUS_CHANGED
  CONSULTATION_NOTES_ADDED
  CONFIG_CHANGED
  FEATURE_FLAG_TOGGLED
  CRON_MANUALLY_TRIGGERED
  REPORT_PRODUCT_CREATED
  REPORT_PROMPT_SAVED
  REPORT_ACTIVATE_TOGGLED
  REPORT_TEST_RUN
  REPORT_REGENERATE
  REPORT_PURCHASE_DELETED
  REPORT_PRODUCT_DELETED
  REPORT_PRODUCT_RESTORED
  PAYMENT_BANK_INSTRUCTIONS_SENT
  USER_IMPERSONATE
  USER_ADMIN_UPDATE
}

enum ReportCategory {
  LIFE_PURPOSE
  CAREER
  RELATIONSHIPS
  SHADOW_WORK
  TIMING
  HEALTH
  FINANCE
  CUSTOM
}

enum ReportPurchaseStatus {
  PENDING
  PAID
  GENERATING
  COMPLETE
  FAILED
}

/// Lifecycle for GeneratedReport rows (admin report logs / regeneration).
enum ReportGenerationStatus {
  PENDING
  GENERATING
  DONE
  FAILED
}
