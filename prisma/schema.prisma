// Crossroads Compass - Prisma Schema
// Personal data is subject to GDPR. Deletion cascades from User. See copilot-instructions section 17.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// AUTH (Auth.js / NextAuth v5 required models)
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          UserRole  @default(USER)
  /// Mirrors role === ADMIN when set; kept in sync by admin user PATCH.
  isAdmin       Boolean   @default(false)

  accounts     Account[]
  sessions     Session[]
  birthProfile BirthProfile?
  astroSnapshot UserAstroSnapshot?
  transits     Transit[]
  dashas       Dasha[]
  insights     Insight[]
  bookings     ConsultationBooking[]
  subscription Subscription?
  reportPurchases ReportPurchase[]
  chatThreads   ChatThread[]
  chatState     UserChatState?

  @@map("users")
}

/// Cosmic Chat thread — messages JSON array `{ role, content }[]` (max 20 turns in app).
model ChatThread {
  id        String   @id
  userId    String
  title     String
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("chat_threads")
}

/// Per-user active Cosmic Chat thread pointer.
model UserChatState {
  userId         String  @id
  activeThreadId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_chat_state")
}

/// Admin-editable Cosmic Chat starter suggestions (empty enabled set falls back to code defaults).
model ChatStarterPrompt {
  id        String   @id @default(cuid())
  label     String
  message   String
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("chat_starter_prompts")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// BIRTH PROFILE & CHART DATA
// See copilot-instructions sections 16, 17, 18 for caching rules.
// ---------------------------------------------------------------------------

model BirthProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Birth data — changing any field bumps profileVersion
  birthName      String
  birthDate      DateTime
  birthTimeKnown Boolean  @default(true)
  birthHour      Int?     // 0-23; null when birthTimeKnown = false (OB-04)
  birthMinute    Int?     // 0-59; null when birthTimeKnown = false (OB-04)
  birthCity      String
  birthCountry   String
  latitude       Float
  longitude      Float
  timezone       String   // IANA timezone e.g. "Europe/Belgrade" — for display only; HD library uses UTC directly

  // Versioning — bumped atomically on birth data change (sections 18, 19)
  profileVersion Int @default(1)

  // Gender — used in HD chart context and personalised report language
  gender String? // "male" | "female" | "other" | null (prefer not to say)

  // Human Design chart — local library (sections 16.2, 18.1)
  // LICENSE PENDING: requires Swiss Ephemeris professional license before go-live
  chartDataHumanDesign  Json?
  hdProfileVersion    Int? // profileVersion at time of last HD calculation (18.1)
  vedicProfileVersion Int? // profileVersion at time of last Vedic fetch (18.2)

  // Typed HD columns for fast indexed querying
  hdType             String?  // Generator | Manifesting Generator | Projector | Manifestor | Reflector
  hdStrategy         String?
  hdAuthority        String?  // Emotional | Sacral | Splenic | Ego | Self-Projected | Mental | Lunar
  hdProfile          String?  // e.g. "1/3"
  hdDefinition       String?  // Single | Split | Triple Split | Quadruple Split | None
  hdIncarnationCross String?
  hdDefinedCenters   String? // JSON-encoded string[] — SQLite has no native arrays
  hdUndefinedCenters String? // JSON-encoded string[]
  hdActiveChannels   String? // JSON-encoded Channel[]
  hdActiveGates      String? // JSON-encoded number[]
  hdInsights         String? // JSON-encoded Record<"type"|"strategy"|"authority"|"profile", {headline,body,practicalTip}>

  // Vedic natal chart — calculated locally via openastrology-library
  chartDataVedic     Json?
  vedicAscendantSign String? // e.g. "scorpio" — fast indexed access without JSON parsing
  vedicSunSign       String? // e.g. "aries"
  vedicMoonSign      String? // e.g. "cancer"
  vedicMahaDasha     String? // current Maha Dasha planet e.g. "saturn"

  // Observation location — used for transit/planet position fetch
  // Null = fall back to birth location
  observationLatitude  Float?
  observationLongitude Float?
  observationCity      String? // human-readable label e.g. "Belgrade, Serbia"

  // Onboarding intake (OB-05)
  intakeLifeSituation String?
  intakePrimaryFocus  String?
  intakeWantsClarity  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("birth_profiles")
}

/// Cached Jyotish UI snapshot — FE-01 through FE-10; written after chart calculation.
model UserAstroSnapshot {
  userId             String    @id
  // FE-01 base
  lagnaSign          String?
  lagnaDegree        Float?
  lagnaNakshatra     String?
  lagnaNakshatraPada Int?
  ayanamsa           Float?
  birthTimeKnown     Boolean?
  vedicChartCachedAt DateTime?

  // FE-11 profile snapshot
  birthDateSnapshot    DateTime?
  birthCitySnapshot    String?
  birthCountrySnapshot String?
  birthLatitude        Float?
  birthLongitude       Float?
  birthTimezone        String?
  profileUpdatedAt     DateTime?
  cacheInvalidatedAt   DateTime?

  // FE-02 planet snapshot (9 planets × core fields)
  sunSign        String?
  sunHouse       Int?
  sunNakshatra   String?
  sunDignity     String?
  sunRetrograde  Boolean?
  sunCombust     Boolean?
  moonSign       String?
  moonHouse      Int?
  moonNakshatra  String?
  moonNakshatraPada Int?
  moonDignity    String?
  marsSign       String?
  marsHouse      Int?
  marsDignity    String?
  marsRetrograde Boolean?
  mercurySign    String?
  mercuryHouse   Int?
  jupiterSign    String?
  jupiterHouse   Int?
  jupiterDignity String?
  venusSign      String?
  venusHouse     Int?
  saturnSign     String?
  saturnHouse    Int?
  saturnRetrograde Boolean?
  rahuSign       String?
  rahuHouse      Int?
  ketuSign       String?
  ketuHouse      Int?
  retrogradeCount Int?
  combustCount    Int?

  // FE-03 house snapshot
  house1Sign   String?
  house1Lord   String?
  house1Strength Float?
  house5Sign   String?
  house5Lord   String?
  house5Strength Float?
  house7Sign   String?
  house7Lord   String?
  house7Strength Float?
  house10Sign  String?
  house10Lord  String?
  house10Strength Float?
  strongestHouseNum Int?
  weakestHouseNum   Int?

  // FE-04 yoga snapshot
  totalYogasCount Int?
  rajaYogasCount  Int?
  dhanaYogasCount Int?
  strongYogasCount Int?
  hasNeechabhanga  Boolean?
  topYogaName      String?
  topYogaStrength  Float?
  yogaNamesAll     String? // JSON-encoded string[]

  // FE-05 dasha snapshot
  mahadashaPlanet       String?
  mahadashaStartDate    DateTime?
  mahadashaEndDate      DateTime?
  mahadashaRemainingYrs Float?
  mahadashaRemainingMos Float?
  antardashaPlanet      String?
  antardashaStartDate   DateTime?
  antardashaEndDate     DateTime?
  nextMahadashaPlanet   String?
  nextMahadashaStartDate DateTime?

  // FE-06 special points snapshot
  arudhaLagnaSign       String?
  arudhaLagnaHouse      Int?
  ghatiLagnaSign        String?
  bhavaLagnaSign        String?
  horaLagnaSign         String?
  atmakarakaPlanet      String?
  amatyakarakaPlanet    String?
  specialPointsCalcAt   DateTime?

  // FE-07 ashtakavarga snapshot
  avSarvaHouse1    Int?
  avSarvaHouse5    Int?
  avSarvaHouse7    Int?
  avSarvaHouse10   Int?
  avSarvaTotal     Int?
  avSarvaMax       Int?
  avSarvaMaxHouse  Int?
  avSarvaMin       Int?
  avSarvaMinHouse  Int?
  avSunBhinna      Float?
  avMoonBhinna     Float?
  avJupiterBhinna  Float?
  avSaturnBhinna   Float?

  // FE-08 divisional snapshot
  d9MoonSign           String?
  d9VenusSign          String?
  d9AscendantSign      String?
  d10SunSign           String?
  d10SaturnSign        String?
  d10AscendantSign     String?
  divisionalChartsCachedAt DateTime?

  // FE-09 daily transit snapshot (refreshed each day)
  transitSunSign       String?
  transitMoonSign      String?
  transitMoonNakshatra String?
  transitMarsSign      String?
  transitJupiterSign   String?
  transitSaturnSign    String?
  transitSaturnRetro   Boolean?
  transitCacheDate     DateTime?

  // FE-10 insight snapshot
  lastInsightDate         DateTime?
  lastInsightGeneratedAt  DateTime?
  insightStreakDays        Int?
  totalInsightsCount       Int?
  insightFeedbackLast      String?

  feJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_astro_snapshots")
}

// ---------------------------------------------------------------------------
// TRANSITS — section 18.3 — one row per user per calendar day
// ---------------------------------------------------------------------------

model Transit {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime // one row per user per calendar day — compare date portion only
  data      Json
  fetchedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("transits")
}

// ---------------------------------------------------------------------------
// DASHAS — section 18.4 — fetched once; deleted when birth data changes
// ---------------------------------------------------------------------------

enum DashaLevel {
  MAHADASHA
  ANTARDASHA
}

model Dasha {
  id         String     @id @default(cuid())
  userId     String
  startDate  DateTime
  endDate    DateTime
  planetName String
  level      DashaLevel
  fetchedAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startDate, endDate])
  @@map("dashas")
}

// ---------------------------------------------------------------------------
// INSIGHTS — DAILY / WEEKLY / MONTHLY generated content (sections 5.2, 6)
// ---------------------------------------------------------------------------

enum InsightType {
  DAILY
  WEEKLY
  MONTHLY
  INITIAL  // foundation report insight (report/generate)
  DASHA    // persisted dasha card back-face insight; periodDate = mahadasha startDate
  CAREER   // VIP life reading — career/vocation (D1 + D10 + HD); periodDate = epoch
  LOVE     // VIP life reading — relationships/love (D1 + D9 + HD); periodDate = epoch
  HEALTH   // VIP life reading — vitality/wellbeing (HD); periodDate = epoch
  JYOTISH  // VIP life reading — comprehensive Vedic synthesis via Gem (D1+D9+D10+Dasha); periodDate = epoch
  MUHURTA_WEEKLY  // cached muhurta AI insight; periodDate = Monday of that week
  SPECIAL_POINTS  // AI explanations for Vedic lagnas and charakarakas; periodDate = epoch
}

model Insight {
  id         String      @id @default(cuid())
  userId     String
  type       InsightType
  // periodDate semantics:
  //   DAILY   -> specific calendar day
  //   WEEKLY  -> Monday of that week
  //   MONTHLY -> 1st of that month
  periodDate DateTime
  content    String

  generatedAt          DateTime  @default(now())
  reviewedByConsultant Boolean   @default(false) // section 6.3 content review
  reviewedAt           DateTime?
  deliveredAt          DateTime?
  rejectedAt           DateTime?
  rejectedBy           String?
  accuracyRating       Int?      // 1-5 user rating from email poll (section 6.3)
  insightFeedback      String?   // 'positive' | 'negative' — FE-10 daily card thumbs

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, periodDate])
  @@index([userId, type, periodDate])
  @@map("insights")
}

// ---------------------------------------------------------------------------
// CONSULTATION BOOKINGS — section 5.4
// ---------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ConsultationTier {
  SINGLE_90      // $150 — 90-min session
  VIP_QUARTERLY  // $497 — quarterly package (CB-06)
}

model ConsultationBooking {
  id                 String           @id @default(cuid())
  userId             String
  tier               ConsultationTier
  status             BookingStatus    @default(PENDING)
  scheduledAt        DateTime?
  calendlyEventId    String?          // MVP = external link; future = embedded (CB-03)
  stripePaymentId    String?
  amountCents        Int
  consultantNotes    String?          // CB-05 (Phase 2)
  prepGuideEmailSent Boolean          @default(false) // CB-04 (Phase 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("consultation_bookings")
}

// ---------------------------------------------------------------------------
// SUBSCRIPTIONS — AC-02 — Stripe-backed tiers FREE / CORE / VIP
// ---------------------------------------------------------------------------

enum SubscriptionTier {
  FREE
  CORE // $29/month
  VIP  // $497/quarter
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// ADMIN — Prompt Templates, Audit Log, Feature Flags, System Config
// ---------------------------------------------------------------------------

enum PromptFeature {
  DAILY_INSIGHT
  WEEKLY_FORECAST
  MONTHLY_REPORT
  HD_TIP
  ONBOARDING_REPORT
  WELCOME_EMAIL
  PRESESSION_EMAIL
  TRANSIT_ALERT_EMAIL
  LIFE_READING
  TRANSIT_READING
}

enum AuditActionType {
  INSIGHT_APPROVED
  INSIGHT_REJECTED
  INSIGHT_EDITED
  PROMPT_SAVED
  PROMPT_ROLLED_BACK
  USER_TIER_CHANGED
  USER_CHART_INVALIDATED
  USER_DELETED
  CONSULTATION_STATUS_CHANGED
  CONSULTATION_NOTES_ADDED
  CONFIG_CHANGED
  FEATURE_FLAG_TOGGLED
  CRON_MANUALLY_TRIGGERED
  REPORT_PRODUCT_CREATED
  REPORT_PROMPT_SAVED
  REPORT_ACTIVATE_TOGGLED
  REPORT_TEST_RUN
  REPORT_REGENERATE
  REPORT_PURCHASE_DELETED
  REPORT_PRODUCT_DELETED
  REPORT_PRODUCT_RESTORED
  PAYMENT_BANK_INSTRUCTIONS_SENT
  USER_IMPERSONATE
  USER_ADMIN_UPDATE
}

model PromptTemplate {
  id                 String                 @id @default(cuid())
  promptKey          String                 @unique
  feature            PromptFeature
  hdType             String?
  systemPrompt       String
  userPromptTemplate String
  bannedPhrases      String                 @default("")
  maxTokens          Int                    @default(800)
  temperature        Float                  @default(0.8)
  version            Int                    @default(1)
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  updatedBy          String

  history PromptTemplateVersion[]

  @@map("prompt_templates")
}

model PromptTemplateVersion {
  id               String         @id @default(cuid())
  promptTemplateId String
  systemPrompt     String
  userPromptTemplate String
  version          Int
  savedAt          DateTime       @default(now())
  savedBy          String

  promptTemplate PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)

  @@index([promptTemplateId])
  @@map("prompt_template_versions")
}

model AuditLog {
  id          String          @id @default(cuid())
  timestamp   DateTime        @default(now())
  adminEmail  String
  actionType  AuditActionType
  targetId    String?
  targetType  String?
  before      String?
  after       String?
  notes       String?
  /// Free-form action label (e.g. task-spec action strings) for admin panel filtering
  actionLabel String?
  detail      String?
  ip          String?

  @@index([adminEmail])
  @@index([actionType])
  @@index([timestamp])
  @@map("audit_logs")
}

model FeatureFlag {
  key       String   @id
  value     Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String

  @@map("feature_flags")
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String

  @@map("system_configs")
}

model CronRun {
  id                String   @id @default(cuid())
  jobName           String
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  usersProcessed    Int      @default(0)
  insightsGenerated Int      @default(0)
  errorCount        Int      @default(0)
  errors            String?

  @@index([jobName])
  @@index([startedAt])
  @@map("cron_runs")
}

// ---------------------------------------------------------------------------
// REPORT MARKETPLACE — paid reports created by admin, generated by Gemini
// ---------------------------------------------------------------------------

enum ReportCategory {
  LIFE_PURPOSE
  CAREER
  RELATIONSHIPS
  SHADOW_WORK
  TIMING
  HEALTH
  FINANCE
  CUSTOM
}

enum ReportPurchaseStatus {
  PENDING
  PAID
  GENERATING
  COMPLETE
  FAILED
}

/// Lifecycle for GeneratedReport rows (admin report logs / regeneration).
enum ReportGenerationStatus {
  PENDING
  GENERATING
  DONE
  FAILED
}

model ReportProduct {
  id            String   @id @default(cuid())
  slug          String   @unique // URL-safe identifier, e.g. "shadow-work-deep-dive"
  title         String
  subtitle      String?
  description   String   // Shown on the reports listing page
  category      ReportCategory
  priceUsd      Int // Stored in cents, e.g. 4900 = $49.00
  isActive      Boolean @default(true) // Admin can deactivate without deleting
  sortOrder     Int     @default(0)
  coverImageUrl String?
  geminiPrompt  String  // Supports placeholders: {{hd_type}}, {{hd_authority}}, ...
  /// Incremented when a new ReportPromptVersion row is saved.
  promptVersion Int     @default(1)
  estimatedWordCount Int @default(2000) // Shown to user as "~X word report"
  /// Set when admin soft-deletes; slug is rewritten with `--del--{id}` to keep slug unique.
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String // Admin email who created it

  purchases      ReportPurchase[]
  promptVersions ReportPromptVersion[]

  @@index([deletedAt])
}

/// Version history for ReportProduct.geminiPrompt (admin prompt editor).
model ReportPromptVersion {
  id              String        @id @default(cuid())
  reportProductId String
  reportProduct   ReportProduct @relation(fields: [reportProductId], references: [id], onDelete: Cascade)
  version         Int
  prompt          String
  savedBy         String
  savedAt         DateTime      @default(now())
  testResult      String?

  @@index([reportProductId])
  @@map("report_prompt_versions")
}

model ReportPurchase {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  reportProductId String
  reportProduct   ReportProduct @relation(fields: [reportProductId], references: [id], onDelete: Cascade)

  stripePaymentId String? @unique
  amountPaidUsd   Int // in cents
  status          ReportPurchaseStatus @default(PENDING)

  generatedReport GeneratedReport?

  purchasedAt     DateTime @default(now())

  @@unique([userId, reportProductId]) // one purchase per user per product
}

model GeneratedReport {
  id               String   @id @default(cuid())
  purchaseId       String   @unique
  purchase         ReportPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  status           ReportGenerationStatus @default(DONE)
  errorMsg         String?
  regeneratedAt    DateTime?
  content          String   @default("") // Full Gemini output; empty while PENDING/GENERATING
  wordCount        Int      @default(0)
  generatedAt      DateTime @default(now())
  geminiModel      String   @default("")
  generationTimeMs Int?
}
