{
  "name": "cc-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate && patch-package",
    "predev": "node scripts/heal-manifests.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "download-ephe": "bash scripts/download-ephe.sh",
    "security:scan-secrets": "bash scripts/scan-secrets.sh",
    "security:scan-tracked": "git --no-pager grep -nE 'AIza[0-9A-Za-z_-]{20,}|GOCSPX-[0-9A-Za-z_-]{10,}|sk_(live|test)_[0-9A-Za-z]{10,}|AKIA[0-9A-Z]{16}|xox[baprs]-[0-9A-Za-z-]{10,}|-----BEGIN (RSA|EC|OPENSSH|PRIVATE) KEY-----' -- . ':(exclude).env' ':(exclude).env.local' || true"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@google/genai": "^1.46.0",
    "@google/generative-ai": "^0.24.0",
    "@node-jhora/core": "^1.5.0",
    "@node-jhora/ephe": "^440.2.0",
    "@node-jhora/ui-react": "^1.5.0",
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/client": "^7.4.2",
    "@react-email/components": "^1.0.9",
    "@supabase/supabase-js": "^2.98.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/suncalc": "^1.9.2",
    "@upstash/redis": "^1.36.3",
    "astronomy-engine": "^2.1.19",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "ogl": "^1.0.11",
    "openastrology-library": "^1.0.0",
    "openhumandesign-library": "github:nikolamilenkovic/openhumandesign-library",
    "prisma": "^7.4.2",
    "puppeteer": "^24.37.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "resend": "^6.9.3",
    "stripe": "^20.4.0",
    "suncalc": "^1.9.0",
    "tailwind-merge": "^3.5.0",
    "tz-lookup": "^6.1.25",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tz-lookup": "^6.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  }
}
